# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Where project files are written (relative to backend/)
STORAGE_DIR=./storage/users

# ── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL instance; Neon and Supabase both have free tiers.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Clerk — https://dashboard.clerk.com → API Keys ──────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Groq — https://console.groq.com/keys ────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Agent guard rails ───────────────────────────────────────────────────────
# Tool-call steps per turn, and AI requests per account per minute.
AGENT_MAX_STEPS=12
AGENT_RATE_LIMIT_PER_MIN=15

# ── End-to-end tests (optional) ─────────────────────────────────────────────
# Run `npm run e2e:user` to provision this account in your Clerk instance.
E2E_USER_EMAIL=forge.e2e+clerk_test@example.com
E2E_USER_PASSWORD=
